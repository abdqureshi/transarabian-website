# Copy this file to .env.local and fill in the public values from:
# Supabase Dashboard > Project Settings > API.
# Never add the service-role key to a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional multipart form endpoint used only when Supabase submission is unavailable.
VITE_APPLICATION_ENDPOINT=
